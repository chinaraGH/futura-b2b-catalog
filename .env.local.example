# Переменные окружения — лендинг Futura (Next.js)
# Скопируйте этот файл в .env.local и заполните реальными значениями.
# Файл .env.local НЕ коммитится в git (он уже в .gitignore).

# ─── Supabase ────────────────────────────────────────────────────────────────
# Найти в: Supabase Dashboard → Project Settings → API

# URL проекта (публичный, используется и на сервере, и на клиенте)
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role ключ — ТОЛЬКО для серверных роутов Next.js (API routes).
# НИКОГДА не передавать на клиент (в браузер).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your-service-role-key...

# ─── Chatbot Backend ─────────────────────────────────────────────────────────
# URL запущенного Express chatbot-сервера (chatbot/src/index.js).
# Виджет чата на лендинге проксирует запросы через этот адрес.
# Локально: http://localhost:3001 (если в chatbot/.env задан PORT=3001)
# Продакшн: https://your-chatbot.railway.app (или другой хостинг)
CHATBOT_URL=http://localhost:3001

# ─── (Опционально) Устаревшие переменные NocoDB — можно удалить ─────────────
# NOCODB_HOST=
# NOCODB_API_TOKEN=
# NOCODB_TABLE_ID=
